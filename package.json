{
  "name": "@globalbrain/sefirot",
  "version": "4.65.0",
  "description": "Vue Components for Global Brain Design System.",
  "keywords": [
    "components",
    "design-system",
    "globalbrain",
    "ui-library",
    "vue",
    "vue3"
  ],
  "homepage": "https://sefirot.globalbrains.com/",
  "license": "MIT",
  "author": "Kia Ishii <ka.ishii@globalbrains.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalbrain/sefirot.git"
  },
  "files": [
    "lib",
    "config",
    "client.d.ts",
    "shared.d.ts"
  ],
  "type": "module",
  "exports": {
    "./client": "./client.d.ts",
    "./shared": "./shared.d.ts",
    "./config/nuxt": "./config/nuxt.js",
    "./config/vite": "./config/vite.js",
    "./dompurify": {
      "types": "./lib/dompurify/index.d.ts",
      "browser": "./lib/dompurify/browser.js",
      "default": "./lib/dompurify/node.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "docs": "pnpm docs:dev",
    "docs:dev": "vitepress dev docs --port 4011",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress serve docs --port 4011",
    "story": "pnpm story:dev",
    "story:dev": "NODE_NO_WARNINGS=1 histoire dev --port 4010",
    "story:build": "NODE_NO_WARNINGS=1 histoire build",
    "story:preview": "NODE_NO_WARNINGS=1 histoire preview --port 4010",
    "type": "vue-tsc --noEmit",
    "lint": "eslint --fix",
    "lint:fail": "eslint --max-warnings 0",
    "test": "vitest",
    "test:fail": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run --aggregate-output '/^(type|lint|test:fail)$/'",
    "check:fail": "pnpm run --aggregate-output '/^(type|lint:fail|test:fail)$/'"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@popperjs/core": "^2.11.8",
    "@sentry/browser": "^11.1.0",
    "@sentry/vue": "^11.1.0",
    "@tanstack/vue-virtual": "^3.13.39",
    "@tinyhttp/content-disposition": "^2.2.4",
    "@tinyhttp/cookie": "^2.1.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/d3": "^7.4.3",
    "@types/lodash-es": "^4.17.12",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/reactivity": "^3.5.43",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "^15.0.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "fuse.js": "^7.5.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^30.1.1",
    "lodash-es": "^4.18.1",
    "magic-string": "^1.4.2",
    "markdown-it": "^15.0.2",
    "normalize.css": "^8.0.1",
    "ofetch": "^1.5.1",
    "pinia": "^4.0.3",
    "postcss": "^8.5.28",
    "postcss-nested": "^8.0.1",
    "qs": "^6.16.0",
    "unplugin-icons": "^24.0.0",
    "v-calendar": "^3.0.1",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@globalbrain/eslint-config": "^4.0.0",
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@typescript-eslint/rule-tester": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "histoire": "^1.0.0-beta.1",
    "typescript": "~6.0.3",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.8.1"
}
