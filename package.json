{
  "name": "@globalbrain/sefirot",
  "version": "4.64.0",
  "description": "Vue Components for Global Brain Design System.",
  "keywords": [
    "components",
    "design-system",
    "globalbrain",
    "ui-library",
    "vue",
    "vue3"
  ],
  "homepage": "https://sefirot.globalbrains.com/",
  "bugs": "https://github.com/globalbrain/sefirot/issues",
  "license": "MIT",
  "author": "Kia Ishii <ka.ishii@globalbrains.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/globalbrain/sefirot.git"
  },
  "files": [
    "lib",
    "config",
    "client.d.ts",
    "shared.d.ts"
  ],
  "type": "module",
  "exports": {
    "./client": "./client.d.ts",
    "./shared": "./shared.d.ts",
    "./config/nuxt": "./config/nuxt.js",
    "./config/vite": "./config/vite.js",
    "./dompurify": {
      "types": "./lib/dompurify/index.d.ts",
      "browser": "./lib/dompurify/browser.js",
      "default": "./lib/dompurify/node.js"
    },
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "docs": "pnpm docs:dev",
    "docs:dev": "vitepress dev docs --port 4011",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress serve docs --port 4011",
    "story": "pnpm story:dev",
    "story:dev": "NODE_NO_WARNINGS=1 VITE_CJS_IGNORE_WARNING=1 histoire dev --port 4010",
    "story:build": "NODE_NO_WARNINGS=1 VITE_CJS_IGNORE_WARNING=1 histoire build",
    "story:preview": "NODE_NO_WARNINGS=1 VITE_CJS_IGNORE_WARNING=1 histoire preview --port 4010",
    "type": "vue-tsc --noEmit",
    "lint": "eslint --fix",
    "lint:fail": "eslint --max-warnings 0",
    "test": "vitest",
    "test:fail": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint --strict",
    "check": "pnpm run --aggregate-output '/^(type|lint|test:fail|publint)$/'",
    "check:fail": "pnpm run --aggregate-output '/^(type|lint:fail|test:fail|publint)$/'"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/ri": "^1.2.10",
    "@popperjs/core": "^2.11.8",
    "@sentry/browser": "^10.73.0",
    "@sentry/vue": "^10.73.0",
    "@tanstack/vue-virtual": "3.0.0-beta.62",
    "@tinyhttp/content-disposition": "^2.2.4",
    "@tinyhttp/cookie": "^2.1.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/body-scroll-lock": "^3.1.2",
    "@types/d3": "^7.4.3",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.2.0",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/reactivity": "^3.5.42",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "@vueuse/core": "^14.4.0",
    "body-scroll-lock": "4.0.0-beta.0",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "fuse.js": "^7.5.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^29.1.1",
    "lodash-es": "^4.18.1",
    "magic-string": "^0.30.21",
    "markdown-it": "^14.3.1",
    "normalize.css": "^8.0.1",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "postcss": "^8.5.28",
    "postcss-nested": "^7.0.2",
    "punycode": "^2.3.1",
    "qs": "^6.16.0",
    "unplugin-icons": "^23.0.1",
    "v-calendar": "3.0.1",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@globalbrain/eslint-config": "^3.1.0",
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.5.0",
    "@typescript-eslint/rule-tester": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.0",
    "histoire": "1.0.0-beta.1",
    "publint": "^0.3.24",
    "typescript": "~6.0.3",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
